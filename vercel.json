{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "DOWNLY_INSTALL_YTDLP=1 npm ci",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "vendor/yt-dlp",
      "maxDuration": 300
    }
  }
}
